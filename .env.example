ENVIRONMENT=development
APP_NAME=SplitEasy API
POSTGRES_DB=splitwise
POSTGRES_USER=splitwise
POSTGRES_PASSWORD=splitwise
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
JWT_SECRET_KEY=replace-with-32-byte-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Comma-separated allowlist for sign-up and sign-in; leave empty to allow any email
# AUTHORIZED_EMAILS=alice@example.com,bob@example.com
AUTHORIZED_EMAILS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
UPLOADS_DIR=/app/uploads

# Google Cloud Storage — base64-encoded service account JSON with read/write/admin object permissions
GCP_SERVICE_ACCOUNT_CREDENTIALS=
GCS_IMAGES_BUCKET_NAME=
GCS_RECEIPTS_IMAGE_FOLDER=receipts
GCS_GROUP_PROFILE_IMAGE_FOLDER=group-profiles
GCS_USER_PROFILE_IMAGE_FOLDER=user-profiles

BACKEND_PORT=8000
FRONTEND_PORT=3000
DOMAIN=localhost