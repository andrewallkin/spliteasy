# ---- Application ----
ENVIRONMENT=development
APP_NAME=SplitEasy API

# ---- Database (required) ----
# docker-compose.dev.yml and docker-compose.standalone.yml use the bundled Postgres
# service; set POSTGRES_HOST=postgres for those stacks.
# Production (docker-compose.yml via the VPS control panel): the panel supplies
# POSTGRES_* connection values and DOCKER_IMAGE_BACKEND / DOCKER_IMAGE_FRONTEND tags.
POSTGRES_DB=splitwise
POSTGRES_USER=splitwise
POSTGRES_PASSWORD=splitwise
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Auth ----
JWT_SECRET_KEY=replace-with-32-byte-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Comma-separated allowlist for register and login; leave empty to allow any email
AUTHORIZED_USERS=

# ---- CORS ----
# Comma-separated browser origins allowed by CORS; must include the exact
# origin users type in the address bar (scheme + host + port)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- OpenRouter ----
# Receipt OCR. Model id is the OpenRouter slug measured in the benchmark.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ---- Google Cloud Storage ----
# GCP_SERVICE_ACCOUNT_CREDENTIALS: base64-encoded service account JSON with
# read/write/admin object permissions
GCP_SERVICE_ACCOUNT_CREDENTIALS=
GCS_IMAGES_BUCKET_NAME=
GCS_RECEIPTS_IMAGE_FOLDER=receipts
GCS_GROUP_PROFILE_IMAGE_FOLDER=group-profiles
GCS_USER_PROFILE_IMAGE_FOLDER=user-profiles

# ---- Compose / operator ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
DOMAIN=localhost
